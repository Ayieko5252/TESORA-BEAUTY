# Your live shop data — products, orders, settings and uploaded photos.
# Kept out of Git so your real shop is never overwritten by a deploy,
# and so customer names and phone numbers never end up on GitHub.
data/

node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
*.tmp

# Netlify CLI local state and build output
.netlify/

# Local data backups taken before a deploy
backups/

# Secrets. Nothing matching this has ever been committed, and this keeps it
# that way: an API key pasted into a .env while debugging is the usual route
# onto GitHub.
.env
.env.*
!.env.example
